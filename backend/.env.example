PORT=5000
MONGO_URI=mongodb+srv://your-mongodb-connection-string
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# Email OTP (use either SMTP_URL or the individual SMTP settings)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="NovuAI <hello@example.com>"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Redis Cache & Queue Configuration (Optional: defaults to 127.0.0.1:6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=rediss://default:password@your-upstash-instance.upstash.io:6379
